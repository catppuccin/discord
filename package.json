{
  "name": "kanagawa-discord",
  "version": "0.2.0",
  "description": "Kanagawa theme for Discord",
  "repository": "https://github.com/vokinn/kanagawa-discord",
  "license": "MIT",
  "author": "vokinn",
  "contributors": [
    {
      "name": "winston",
      "email": "hey@winston.sh"
    }
  ],
  "private": true,
  "scripts": {
    "build": "mkdir -p dist/dist && sass -I node_modules --no-charset --no-source-map src:dist/dist",
    "release": "mkdir -p dist/dist && sass -I node_modules --style=compressed --no-charset --no-source-map src:dist/dist",
    "watch": "mkdir -p dist/dist && sass -I node_modules --no-charset --no-source-map src:dist/dist -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": ">=6",
    "lint-staged": ">=10",
    "prettier": "^3.0.0",
    "sass": "^1.55.0"
  },
  "lint-staged": {
    "*.{js,sass,scss}": "prettier --write"
  }
}
